[Unit]
Description=Nebula Calligraphy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/data/nebula-calligraphy
ExecStart=/data/nebula-calligraphy/bin/calligraphy
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
UMask=0077

Environment=PORT=8090
Environment=CALLIGRAPHY_RUNTIME_PROFILE=production
Environment=CALLIGRAPHY_AUTH_FILE=/data/nebula-calligraphy/state/auth.json
Environment=CALLIGRAPHY_DATA_FILE=/data/nebula-calligraphy/state/drafts.json
Environment=CALLIGRAPHY_LEARNING_FILE=/data/nebula-calligraphy/state/learning.json
Environment=CALLIGRAPHY_AUDIT_FILE=/data/nebula-calligraphy/state/audit.jsonl
Environment=CALLIGRAPHY_EXPORT_DIR=/data/nebula-calligraphy/state/artifacts
Environment=CALLIGRAPHY_WEB_DIR=/data/nebula-calligraphy/web
Environment=CALLIGRAPHY_RENDER_FONT_FILE=/data/nebula-calligraphy/assets/fonts/MaShanZheng-Regular.ttf
Environment=CALLIGRAPHY_RENDER_CACHE_DIR=/data/nebula-calligraphy/state/render-cache
Environment=CALLIGRAPHY_LEARNING_TIMEZONE=Asia/Shanghai
Environment=CALLIGRAPHY_SESSION_TTL=24h

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/data/nebula-calligraphy/state

[Install]
WantedBy=multi-user.target
